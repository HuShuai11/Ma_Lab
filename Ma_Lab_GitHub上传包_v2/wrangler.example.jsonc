{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ma-lab-showcase",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ma-lab-content",
      "database_id": "请替换为 Cloudflare 创建 D1 数据库后显示的数据库 ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ma-lab-media"
    }
  ]
}
